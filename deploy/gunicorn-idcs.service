[Unit]
Description=Gunicorn daemon for IDCS project
After=network.target

[Service]
User=iqac2
Group=www-data
UMask=0007
WorkingDirectory=/home/iqac2/Desktop/idcs-mt/backend
EnvironmentFile=/home/iqac2/Desktop/idcs-mt/backend/.env
Environment=ENVIRONMENT=development

ExecStart=/home/iqac2/Desktop/idcs-mt/backend/.venv/bin/gunicorn \
    --worker-class gthread \
    --workers 4 \
    --threads 2 \
    --timeout 60 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1500 \
    --max-requests-jitter 150 \
    --worker-tmp-dir /dev/shm \
    --bind unix:/run/gunicorn-idcs/idcs.sock \
    --access-logfile - \
    --error-logfile - \
    erp.wsgi:application

Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
LimitNOFILE=65536
RuntimeDirectory=gunicorn-idcs
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
