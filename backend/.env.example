# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
# Optional explicit key for field-level encryption of stored credentials/tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Production DB only (PostgreSQL)
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432

# Email Configuration (for password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# AWS S3 Configuration (if using S3 for media/static files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# CORS / CSRF origin settings
# Production: set only deployed UI origins (comma-separated).
CORS_ALLOWED_ORIGINS=https://idcs.krgi.co.in,https://db.krgi.co.in
CSRF_TRUSTED_ORIGINS=https://idcs.krgi.co.in,https://db.krgi.co.in
# Optional debug-only additions (applied only when DEBUG=True)
CORS_DEV_EXTRA_ORIGINS=
CSRF_DEV_EXTRA_ORIGINS=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# WhatsApp Integration (if applicable)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Other API Keys
CANVA_API_KEY=

# Staff biometric realtime security (used by /api/staff-attendance/biometric/realtime/)
# REQUIRED in production and must be >= 24 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_BIOMETRIC_INGEST_KEY=change-this-to-a-long-random-token

# API key for machine-to-machine marks reporting API access.
# Send as header: X-Reporting-Api-Key: <value>
REPORTING_API_KEY=change-this-to-a-long-random-token

# --- Registration policy ---
# Open self-service registration is disabled by default (admin-managed only).
# Set to 1 only if public signup is intentional.
ENABLE_OPEN_REGISTRATION=0

# --- Super admin isolation ---
# Super-admin account login requires a separate access key (sent as `sa_key`).
SUPER_ADMIN_EMAIL=admin@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPER_ADMIN_ACCESS_KEY=

# --- Password policy ---
# Minimum length enforced by Django password validators.
PASSWORD_MIN_LENGTH=8

# --- API rate limiting (DRF) ---
THROTTLE_ANON_RATE=100/min
THROTTLE_USER_RATE=1000/min
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REFRESH_RATE=30/min
THROTTLE_OTP_RATE=5/min
THROTTLE_REGISTER_RATE=5/hour
THROTTLE_BIOMETRIC_RATE=120/min

# --- JWT lifetime & httpOnly cookie auth ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_HOURS=12
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=1
JWT_COOKIE_HTTPONLY=1
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_PATH=/
JWT_COOKIE_DOMAIN=

# --- Protected media serving ---
# Production routes /media/ through Django (nginx proxy + X-Accel-Redirect).
# Anonymous access is only allowed for these prefixes; everything else
# requires authentication or a signed URL.
PUBLIC_MEDIA_PREFIXES=profile_images/,announcements/covers/,announcements/themes/,event_posters/
USE_X_ACCEL_REDIRECT=1

# eSSL biometric device defaults (used by sync_essl_realtime command)
ESSL_DEVICE_IP=192.168.81.80
ESSL_DEVICE_PORT=4370
ESSL_DEVICE_PASSWORD=0
ESSL_CONNECT_TIMEOUT=8
ESSL_RECONNECT_DELAY=5
